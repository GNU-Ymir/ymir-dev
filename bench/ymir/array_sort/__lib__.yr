in __lib__;

use std::io;
use std::time::instant;
use std::algorithm::sorting;

fn runBench(work: dg ()-> void) {
    let mut i = 0u32;
    while i < 2u32 { work(); i += 1u32; }

    i = 0u32;
    while i < 21u32 {
        let start = Instant::now();
        work();
        let end = Instant::now();
        println (cast!f64((end - start).allMicros) / 1000.0);
        i += 1u32;
    }
}

fn main () {
    let dmut sink = copy [0i64];

    let f : dg ()-> void = copy || => {
        let n = 50000us;
        let dmut a = array::allocArray!i64(n);
        let mut x = 12345u64;
        let mut i = 0us;
        while i < n {
            x = x * 6364136223846793005u64 + 1442695040888963407u64;
            a[i] = cast!i64(x % 1000000u64);
            i += 1us;
        }

        let dmut sorted = sorting::sort(alias a, |x, y| => { x < y });
        sink[0] = sorted[0];
    };

    runBench(f);
}
