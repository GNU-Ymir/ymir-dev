in __lib__;

use std::io;
use std::time::instant;
use std::conv;

fn runBench(work: dg ()-> void) {
    let mut i = 0u32;
    while i < 2u32 { work(); i += 1u32; }

    i = 0u32;
    while i < 21u32 {
        let start = Instant::now();
        work();
        let end = Instant::now();
        println (cast!f64((end - start).allMicros) / 1000.0);
        i += 1u32;
    }
}

fn main () {
    let dmut sink = copy [0us];

    let f : dg ()-> void = copy || => {
        let dmut s : [c8] = copy "";
        let mut i = 0u64;
        while i < 20000u64 {
            s ~= "tok"s8;
            s ~= conv::to!{[c8]}(i);
            s ~= "_"s8;
            i += 1u64;
        }
        sink[0] = s.len;
    };

    runBench(f);
}
