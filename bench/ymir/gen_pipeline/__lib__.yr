in __lib__;

use std::algorithm::iteration;
use std::io;
use std::time::instant;

fn runBench(work: dg ()-> void) {
    let mut i = 0u32;
    while i < 2u32 { work(); i += 1u32; }

    i = 0u32;
    while i < 21u32 {
        let start = Instant::now();
        work();
        let end = Instant::now();
        println (cast!f64((end - start).allMicros) / 1000.0);
        i += 1u32;
    }
}

yield range (n: i64)-> i64 {
    let mut i = 0i64;
    while i < n {
        yield i;
        i += 1i64;
    }
}

fn main () {
    let dmut sink = copy [0i64];

    let f : dg ()-> void = copy || => {
        sink[0] = range (10000000i64).map!{|x| => x * 3i64} ().filter (|x| => x % 2i64 == 0i64).sum ();
    };

    runBench(f);
}
