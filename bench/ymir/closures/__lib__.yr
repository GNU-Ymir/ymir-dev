in __lib__;

use std::io;
use std::time::instant;

fn runBench(work: dg ()-> void) {
    let mut i = 0u32;
    while i < 2u32 { work(); i += 1u32; }

    i = 0u32;
    while i < 21u32 {
        let start = Instant::now();
        work();
        let end = Instant::now();
        println (cast!f64((end - start).allMicros) / 1000.0);
        i += 1u32;
    }
}

fn main () {
    let n = 500000us;
    let dmut data = array::allocArray!i64(n);
    let mut i = 0us;
    while i < n {
        data[i] = cast!i64(i);
        i += 1us;
    }

    let dmut sink = copy [0i64];

    let f : dg ()-> void = copy || => {
        let g : dg (i64)-> i64 = |x| => { x * x + 1 };
        let mut total = 0i64;
        for v in data {
            total += g(v);
        }
        sink[0] = total;
    };

    runBench(f);
}
